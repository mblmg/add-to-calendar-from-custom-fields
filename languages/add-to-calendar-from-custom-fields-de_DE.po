#. Description of the plugin
#: add-to-calendar-from-custom-fields.php
msgid "Turns dates you already store in custom fields (ACF, ACPT or plain post meta) into calendar entries: an .ics file per event, links for Google Calendar and Outlook, a subscribable calendar feed and schema.org event markup for search engines. Works with any theme, with extra dynamic data fields for Breakdance."
msgstr "Macht aus Terminen, die bereits in eigenen Feldern stehen (ACF, ACPT oder normale Post-Meta), Kalendereinträge: eine .ics-Datei pro Termin, Links für Google Kalender und Outlook, einen abonnierbaren Kalender-Feed und eine schema.org-Auszeichnung für Suchmaschinen. Funktioniert mit jedem Theme, mit zusätzlichen dynamischen Datenfeldern für Breakdance."

#: includes/breakdance-field.php:29 includes/class-admin.php:17
msgid "Add to Calendar"
msgstr "Zum Kalender hinzufügen"

#: includes/class-admin.php:16 includes/class-admin.php:94
msgid "Add to Calendar from Custom Fields"
msgstr "Add to Calendar from Custom Fields"

#: includes/class-admin.php:36
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-admin.php:45
msgid "Event fields"
msgstr "Terminfelder"

#: includes/class-admin.php:46
msgid "Calendar files"
msgstr "Kalenderdateien"

#: includes/class-admin.php:47
msgid "Search engines"
msgstr "Suchmaschinen"

#: includes/class-admin.php:54 includes/class-admin.php:205
msgid "Structured data"
msgstr "Strukturierte Daten"

#: includes/class-admin.php:54
msgid "Adds schema.org event markup (JSON-LD) to each event page, so search engines like Google can show the event with date and place in their event listings. Turn it off if another plugin already does this."
msgstr "Ergänzt jede Terminseite um eine schema.org-Auszeichnung (JSON-LD). So können Suchmaschinen wie Google den Termin mit Datum und Ort in ihren Veranstaltungslisten zeigen. Schalte die Option aus, wenn ein anderes Plugin das schon übernimmt."

#: includes/class-admin.php:55
msgid "Doors time field (optional)"
msgstr "Feld für den Einlass (optional)"

#: includes/class-admin.php:55
msgid "If this field is also one of the start time fields, calendars still start at the doors time, but search engines get the start of the programme as start and the doors time separately."
msgstr "Ist dieses Feld auch eines der Startzeit-Felder, beginnt der Termin im Kalender weiterhin mit dem Einlass. Suchmaschinen bekommen dagegen den Programmbeginn als Start und den Einlass gesondert."

#: includes/class-admin.php:56
msgid "Ticket link field (optional)"
msgstr "Feld für den Ticketlink (optional)"

#: includes/class-admin.php:56
msgid "Field with a link to buy tickets or register."
msgstr "Feld mit einem Link zum Ticketkauf oder zur Anmeldung."

#: includes/class-admin.php:57
msgid "Price field (optional)"
msgstr "Preisfeld (optional)"

#: includes/class-admin.php:57
msgid "Field with the price, e.g. <code>12</code>, <code>12,50 €</code> or <code>free</code>."
msgstr "Feld mit dem Preis, z. B. <code>12</code>, <code>12,50 €</code> oder <code>frei</code>."

#: includes/class-admin.php:58
msgid "Currency"
msgstr "Währung"

#: includes/class-admin.php:58
msgid "Three-letter code, e.g. <code>EUR</code>."
msgstr "Dreistelliger Code, z. B. <code>EUR</code>."

#: includes/class-admin.php:59
msgid "Country"
msgstr "Land"

#: includes/class-admin.php:59
msgid "Two-letter code of the venue country, e.g. <code>DE</code>."
msgstr "Zweistelliger Code des Landes, in dem der Veranstaltungsort liegt, z. B. <code>DE</code>."

#: includes/class-admin.php:60
msgid "Default venue name"
msgstr "Standard-Veranstaltungsort"

#: includes/class-admin.php:60
msgid "Used when an event has no location fields filled. The first location field is read as venue name, the others as address."
msgstr "Wird verwendet, wenn bei einem Termin kein Ortsfeld ausgefüllt ist. Das erste Ortsfeld gilt als Name des Veranstaltungsorts, die weiteren als Adresse."

#: includes/class-admin.php:61
msgid "Default venue address"
msgstr "Standard-Adresse"

#: includes/class-admin.php:61
msgid "Format: <code>Street 1, 12345 City</code>."
msgstr "Format: <code>Straße 1, 12345 Stadt</code>."

#: includes/class-admin.php:62
msgid "Organizer"
msgstr "Veranstalter"

#: includes/class-admin.php:62
msgid "Name of the organizer. Empty = no organizer."
msgstr "Name des Veranstalters. Leer = keine Angabe."

#: includes/class-admin.php:63
msgid "Organizer website"
msgstr "Website des Veranstalters"

#: includes/class-admin.php:70
msgid "Post type"
msgstr "Beitragstyp"

#: includes/class-admin.php:70
msgid "Slug of the post type that holds the events, e.g. <code>event</code>."
msgstr "Slug des Beitragstyps, der die Termine enthält, z. B. <code>event</code>."

#: includes/class-admin.php:71
msgid "Date field"
msgstr "Datumsfeld"

#: includes/class-admin.php:71
msgid "Field name (meta key) of the date. Required."
msgstr "Feldname (Meta-Key) des Datums. Pflichtfeld."

#: includes/class-admin.php:72
msgid "End date field (optional)"
msgstr "Enddatum-Feld (optional)"

#: includes/class-admin.php:72
msgid "Only needed for events spanning several days."
msgstr "Nur für mehrtägige Termine nötig."

#: includes/class-admin.php:73
msgid "Start time fields"
msgstr "Startzeit-Felder"

#: includes/class-admin.php:73
msgid "One or more fields, separated by commas. The first field with a value is used. If none has a value, the event is added as an all-day event."
msgstr "Ein oder mehrere Felder, durch Komma getrennt. Das erste befüllte Feld wird verwendet. Ist keins befüllt, wird der Termin ganztägig eingetragen."

#: includes/class-admin.php:74
msgid "End time field (optional)"
msgstr "Endzeit-Feld (optional)"

#: includes/class-admin.php:74
msgid "If the end time is earlier than the start time, the event ends on the next day."
msgstr "Liegt die Endzeit vor der Startzeit, endet der Termin am Folgetag."

#: includes/class-admin.php:75
msgid "Default duration in minutes"
msgstr "Standard-Dauer in Minuten"

#: includes/class-admin.php:75
msgid "Used when no end time is set."
msgstr "Gilt, wenn keine Endzeit gepflegt ist."

#: includes/class-admin.php:76
msgid "Location fields (optional)"
msgstr "Ort-Felder (optional)"

#: includes/class-admin.php:76
msgid "One or more fields, separated by commas. They are combined into one location."
msgstr "Ein oder mehrere Felder, durch Komma getrennt. Sie werden zu einer Ortsangabe zusammengesetzt."

#: includes/class-admin.php:77
msgid "Description field (optional)"
msgstr "Beschreibungs-Feld (optional)"

#: includes/class-admin.php:77
msgid "Field for the description. Empty = the post excerpt, or the beginning of the post content if there is no excerpt. In calendars, the link to the post is always added."
msgstr "Feld für die Beschreibung. Leer = der Textauszug des Beitrags oder, wenn es keinen gibt, der Anfang des Beitragstexts. Im Kalender wird immer der Link zum Beitrag angehängt."

#: includes/class-admin.php:78
msgid "Base path"
msgstr "Basis-Adresse"

#: includes/class-admin.php:78
msgid "Results in the addresses /<em>base</em>/event-123.ics and /<em>base</em>/<em>feed</em>.ics."
msgstr "Ergibt die Adressen /<em>basis</em>/event-123.ics und /<em>basis</em>/<em>feed</em>.ics."

#: includes/class-admin.php:79
msgid "Feed file name"
msgstr "Dateiname des Abos"

#: includes/class-admin.php:79
msgid "Without .ics."
msgstr "Ohne .ics."

#: includes/class-admin.php:80
msgid "Subscription calendar name"
msgstr "Name des Abo-Kalenders"

#: includes/class-admin.php:80
msgid "The name subscribers see in their calendar app."
msgstr "So heißt der Kalender in der Kalender-App der Abonnent:innen."

#: includes/class-admin.php:81
msgid "Past days in the feed"
msgstr "Vergangene Tage im Abo"

#: includes/class-admin.php:81
msgid "How long past events stay visible in the subscription."
msgstr "So lange bleiben vergangene Termine im Abo sichtbar."

#: includes/class-admin.php:95
msgid "Reads the event data from existing fields (ACF, ACPT or plain post meta). Nothing has to be entered twice."
msgstr "Liest die Termindaten aus vorhandenen Feldern (ACF, ACPT oder normale Post-Meta). Es muss nichts doppelt gepflegt werden."

#: includes/class-admin.php:111
msgid "Output structured data on event pages"
msgstr "Strukturierte Daten auf Terminseiten ausgeben"

#: includes/class-admin.php:127
msgid "Save settings"
msgstr "Einstellungen speichern"

#: includes/class-admin.php:148
msgid "Available fields"
msgstr "Verfügbare Felder"

#. translators: %s: title of a sample post
#: includes/class-admin.php:150
msgid "Field names and values of the sample post \"%s\":"
msgstr "Feldnamen und Werte am Beispiel von „%s“:"

#. translators: %s: title of a sample post
#: includes/class-admin.php:151
msgid "Field name"
msgstr "Feldname"

#. translators: %s: title of a sample post
#: includes/class-admin.php:151
msgid "Value"
msgstr "Wert"

#: includes/class-admin.php:169
msgid "Preview"
msgstr "Vorschau"

#: includes/class-admin.php:170
msgid "Subscription URL:"
msgstr "Abo-Adresse:"

#: includes/class-admin.php:172
msgid "No events found in the feed period. Are the post type and the date field correct?"
msgstr "Im Abo-Zeitraum wurden keine Termine gefunden. Stimmen Beitragstyp und Datumsfeld?"

#: includes/class-admin.php:178
msgid "Event"
msgstr "Termin"

#: includes/class-admin.php:179
msgid "Start"
msgstr "Beginn"

#: includes/class-admin.php:180
msgid "End"
msgstr "Ende"

#: includes/class-admin.php:181
msgid "Location"
msgstr "Ort"

#: includes/class-admin.php:182
msgid "File"
msgstr "Datei"

#: includes/class-admin.php:186
msgid "(all day)"
msgstr "(ganztägig)"

#. translators: %s: event title
#: includes/class-admin.php:207
msgid "This is what search engines read on the page of \"%s\":"
msgstr "Das lesen Suchmaschinen auf der Seite von „%s“:"

#: includes/class-admin.php:212
msgid "Check this page with Google's Rich Results Test"
msgstr "Diese Seite mit Googles Test für Rich-Suchergebnisse prüfen"

#: includes/class-admin.php:217
msgid "Usage"
msgstr "Verwendung"

#: includes/class-admin.php:218
msgid "In the link field of a button or text link, choose the dynamic data category \"Add to Calendar\"."
msgstr "Im Link-Feld eines Buttons oder Text-Links in den dynamischen Daten die Kategorie „Zum Kalender hinzufügen“ wählen."

